# Local (variables separadas)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=simulador_preguntas
PORT=3001

# Producción (Railway inyecta esta variable automáticamente)
# DATABASE_URL=postgresql://user:pass@host:port/db

# Modo debug: carga todas las preguntas del bloque en orden (sin límite ni aleatorio)
# Nunca activar en producción
DEBUG=false

# Clave secreta para firmar JWT (usar una cadena larga y aleatoria en producción)
JWT_SECRET=
